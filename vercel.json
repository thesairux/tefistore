{
  "buildCommand": "sh herramientas/construir.sh",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": {
    "api/asistente.js": { "includeFiles": "catalogo.js" }
  },
  "headers": [
    { "source": "/catalogo.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }] }
  ]
}
